"""
    Exercice 11 - Calculatrice robuste [moyen]
        Demander deux nombres et une opération (+, -, *, /). Afficher le résultat. Le programme ne doit jamais
        planter : gérer la division par zéro et l'opération inconnue.



def operation():
    nombre1 = int(input("Saisissez le premier nombre: "))
    nombre2 = int(input("Saisissez le deuxième nombre: "))
    operation= input("Saisissez l'opération à effectuer (+, -, *, /): ")
    if operation == "+":
        resultat= nombre1 + nombre2
        print(f"Le resultat est {resultat}")
    elif operation == "-":
        resultat= nombre1 - nombre2
        print(f"Le resultat est {resultat}")
    elif operation == "*":
        resultat= nombre1 * nombre2
        print(f"Le resultat est {resultat}")
    elif operation == "/":
        if nombre2 != 0:
            resultat= nombre1 / nombre2
            print(f"Le resultat est {resultat}")
        else:
            print("Erreur: division par zéro.")
    else:
        print("Erreur: opération inconnue.")

operation()


